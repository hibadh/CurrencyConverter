<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_clair"
    android:id="@+id/main">

    <!-- Séparation entre l'affichage et le clavier -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineClavier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.45" />

    <!-- Zone supérieure -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/zoneAffichage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/turquoise"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guidelineClavier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titre"
            android:textColor="@color/blanc"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/spDeviseSource"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:contentDescription="@string/devise_source_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitre"
            app:layout_constraintBottom_toTopOf="@id/btnInverser" />

        <TextView
            android:id="@+id/tvMontant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/montant_initial"
            android:textColor="@color/texte_noir"
            android:textSize="48sp"
            android:gravity="end"
            android:maxLines="1"
            android:singleLine="true"
            android:contentDescription="@string/montant_description"
            android:paddingEnd="4dp"
            android:backgroundTint="@color/texte_noir"
            app:layout_constraintStart_toEndOf="@id/spDeviseSource"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitre"
            app:layout_constraintBottom_toTopOf="@id/btnInverser" />


        <ImageButton
            android:id="@+id/btnInverser"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_inverser"
            android:background="@android:color/transparent"
            android:contentDescription="@string/inverser_description"
            android:scaleType="fitCenter"
            app:tint="#222222"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spDeviseSource"
            app:layout_constraintBottom_toTopOf="@id/spDeviseCible" />


        <Spinner
            android:id="@+id/spDeviseCible"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:contentDescription="@string/devise_cible_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnInverser"
            app:layout_constraintBottom_toTopOf="@id/btnConvertir" />

        <TextView
            android:id="@+id/tvResultat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/resultat_initial"
            android:textColor="@color/texte_noir"
            android:textSize="48sp"
            android:gravity="end"
            android:maxLines="1"
            android:singleLine="true"
            android:contentDescription="@string/resultat_description"
            android:paddingEnd="4dp"
            app:layout_constraintStart_toEndOf="@id/spDeviseCible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnInverser"
            app:layout_constraintBottom_toTopOf="@id/btnConvertir" />

        <Button
            android:id="@+id/btnConvertir"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:text="@string/convertir"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Clavier numérique -->
    <TableLayout
        android:id="@+id/tableClavier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:stretchColumns="*"
        android:shrinkColumns="*"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/guidelineClavier"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn7"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_7"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn8"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_8"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn9"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_9"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn4"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_4"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn5"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_5"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn6"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_6"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn1"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_1"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn2"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_2"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn3"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_3"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnC"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/effacer"
                android:textColor="@color/rouge_effacer"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn0"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_zero"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btnPoint"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/point"
                android:textColor="@color/turquoise_clavier"
                android:textSize="32sp" />
        </TableRow>

    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
