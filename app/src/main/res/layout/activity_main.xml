<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_ecran">

    <!-- Séparation entre l'affichage et le clavier -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineClavier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.52" />

    <!-- Zone supérieure (Carte d'affichage) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/zoneAffichage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_zone_affichage"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/guidelineClavier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/titre"
            android:textColor="@color/texte_principal"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Spinner
            android:id="@+id/spDeviseSource"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:contentDescription="@string/devise_source_description"
            app:layout_constraintBottom_toTopOf="@id/btnInverser"
            android:textColor="@color/texte_principal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitre" />

        <TextView
            android:id="@+id/tvMontant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/montant_description"
            android:gravity="end"
            android:maxLines="1"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:text="@string/montant_initial"
            android:textColor="@color/texte_principal"
            android:textSize="40sp"
            app:layout_constraintBaseline_toBaselineOf="@id/spDeviseSource"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/spDeviseSource" />

        <View
            android:id="@+id/lineMontant"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="2dp"
            android:background="@color/ligne_soulignement"
            app:layout_constraintEnd_toEndOf="@id/tvMontant"
            app:layout_constraintStart_toStartOf="@id/tvMontant"
            app:layout_constraintTop_toBottomOf="@id/tvMontant" />

        <ImageButton
            android:id="@+id/btnInverser"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/inverser_description"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_inverser"
            app:layout_constraintBottom_toTopOf="@id/spDeviseCible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spDeviseSource"
            app:tint="@color/texte_principal" />

        <Spinner
            android:id="@+id/spDeviseCible"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:contentDescription="@string/devise_cible_description"
            app:layout_constraintBottom_toTopOf="@id/btnConvertir"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnInverser" />

        <TextView
            android:id="@+id/tvResultat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/resultat_description"
            android:gravity="end"
            android:maxLines="1"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:text="@string/resultat_initial"
            android:textColor="@color/texte_principal"
            android:textSize="40sp"
            app:layout_constraintBaseline_toBaselineOf="@id/spDeviseCible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/spDeviseCible" />

        <View
            android:id="@+id/lineResultat"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="2dp"
            android:background="@color/ligne_soulignement"
            app:layout_constraintEnd_toEndOf="@id/tvResultat"
            app:layout_constraintStart_toStartOf="@id/tvResultat"
            app:layout_constraintTop_toBottomOf="@id/tvResultat" />

        <Button
            android:id="@+id/btnConvertir"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:text="@string/convertir"
            android:textColor="@color/btn_convertir_texte"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/btn_convertir_bg"
            app:cornerRadius="26dp"
            app:strokeColor="@color/btn_convertir_stroke"
            app:strokeWidth="1.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <TableLayout
        android:id="@+id/tableClavier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        android:shrinkColumns="*"
        android:stretchColumns="*"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guidelineClavier">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn7"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_7"
                android:textColor="@color/clavier_chiffre"
                android:textSize="34sp" />

            <Button
                android:id="@+id/btn8"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_8"
                android:textColor="@color/clavier_chiffre"
                android:textSize="34sp" />

            <Button
                android:id="@+id/btn9"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_9"
                android:textColor="@color/clavier_chiffre"
                android:textSize="34sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn4"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_4"
                android:textColor="@color/clavier_chiffre"
                android:textSize="34sp" />

            <Button
                android:id="@+id/btn5"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_5"
                android:textColor="@color/clavier_chiffre"
                android:textSize="34sp" />

            <Button
                android:id="@+id/btn6"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_6"
                android:textColor="@color/clavier_chiffre"
                android:textSize="34sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn1"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_1"
                android:textColor="@color/clavier_chiffre"
                android:textSize="34sp" />

            <Button
                android:id="@+id/btn2"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_2"
                android:textColor="@color/clavier_chiffre"
                android:textSize="34sp" />

            <Button
                android:id="@+id/btn3"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_3"
                android:textColor="@color/clavier_chiffre"
                android:textSize="34sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnC"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/effacer"
                android:textColor="@color/clavier_effacer"
                android:textSize="34sp" />

            <Button
                android:id="@+id/btn0"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_zero"
                android:textColor="@color/clavier_chiffre"
                android:textSize="34sp" />

            <Button
                android:id="@+id/btnPoint"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/point"
                android:textColor="@color/clavier_chiffre"
                android:textSize="34sp" />
        </TableRow>

    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
